        TA = top_k_candidates(V_A, score_marginal_A, k=topk)
        TB = top_k_candidates(V_B, score_marginal_B, k=topk)

        best_val = -np.inf
        best_theta = None
        for a in TA:
            for b in TB:
                cand = np.array([a[0], b[1], a[1], b[0]])
                if is_feasible(cand, V):
                    val = objective(cand, strength)
                else:
                    vprime = nearest_feasible_vertex(cand, V)
                    val = objective(vprime, strength)
                if val > best_val:
                    best_val = val
                    best_theta = cand

        # evaluate for different Fisher scales
        for f in f_scales:
            F = synthetic_fisher(f)
            eps = compute_epsilon(F)
            # compute Phi(eps) with placeholder constants
            lambda_min = 0.5
            theta_norm = np.linalg.norm(global_best)
            Phi = 0.5 * (eps**2) / lambda_min * (theta_norm**2) * np.linalg.norm(np.block([[F[:2,:2], np.zeros((2,2))],[np.zeros((2,2)), F[2:,2:]]]), ord='fro')
            results.append({
                'strength': strength,
                'f_scale': f,
                'epsilon': eps,
                'Phi': Phi,
                'global_val': global_val,
                'probe_val': best_val,
                'gap': global_val - best_val,
                'global_theta': global_best,
                'probe_theta': best_theta
            })
    return results

# --- Run experiment and plot ----------------------------------------------
strengths = [0.5, 1.0, 2.0, 4.0]
f_scales = [0.0, 0.1, 0.3, 0.6]
res = run_experiment(strengths, f_scales, topk=4)

# Print summary table
for r in res:
    print(f"strength={r['strength']:.2f} f_scale={r['f_scale']:.2f} eps={r['epsilon']:.3f} gap={r['gap']:.3f} Phi={r['Phi']:.3f}")

# Plot gap vs epsilon aggregated by strength
plt.figure(figsize=(8,5))
for s in strengths:
    xs = [r['epsilon'] for r in res if r['strength']==s]
    ys = [r['gap'] for r in res if r['strength']==s]
    plt.plot(xs, ys, marker='o', label=f"strength={s}")
plt.xlabel('epsilon')
plt.ylabel('global - probe gap')
plt.title('Probe gap vs epsilon for various coupling strengths')
plt.legend()
plt.grid(True)
plt.show()
```

**How to interpret results**  
- The printed table shows empirical \(\varepsilon\), the probe gap, and the certificate \(\Phi(\varepsilon)\).  
- When \(\varepsilon\) is small and the gap is below \(\Phi(\varepsilon)\), the probe is certified near‑optimal.  
- When \(\varepsilon\) grows and the gap exceeds \(\Phi(\varepsilon)\), the Fisher‑controlled separability fails and a full search or richer probe is required.

