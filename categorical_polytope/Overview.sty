# extremal_probe_experiment.py
import numpy as np
import itertools
import matplotlib.pyplot as plt

# --- Problem setup ---------------------------------------------------------
# Box H = [0,1]^4 with theta = (lambda, sigma, k, B)
bounds = np.array([[0.0,1.0]]*4)

def face_bowl(theta, strength):
    lam, sig = theta[0], theta[1]
    return -strength * (1 - (lam - 0.5)**2) * (1 - (sig - 0.5)**2)

def g_block(thetaA, alpha=(1.0,2.0)):
    lam, k = thetaA
    return alpha[0]*lam + alpha[1]*k

def h_block(thetaB, beta=(3.0,4.0)):
    B, sig = thetaB
    return beta[0]*B + beta[1]*sig

def objective(theta, strength):
    thetaA = theta[[0,2]]
    thetaB = theta[[3,1]]
    return g_block(thetaA) + h_block(thetaB) + face_bowl(theta, strength)

# --- Vertex enumeration for H ----------------------------------------------
def vertices_of_box(bounds):
    n = bounds.shape[0]
    verts = []
    for bits in itertools.product([0,1], repeat=n):
        v = np.array([bounds[i,bits[i]] for i in range(n)])
        verts.append(v)
    return np.array(verts)

V = vertices_of_box(bounds)

# --- Marginal projections and top-k selection -------------------------------
def project_vertices(V, indices):
    proj = np.unique(V[:, indices], axis=0)
    return proj

# Indices: A = [0,2], B = [3,1]
idxA = [0,2]
idxB = [3,1]
V_A = project_vertices(V, idxA)
V_B = project_vertices(V, idxB)

def score_marginal_A(vA):
    return g_block(vA)

def score_marginal_B(vB):
    return h_block(vB)

def top_k_candidates(Vproj, score_fn, k=4):
    scores = [(i, score_fn(Vproj[i])) for i in range(len(Vproj))]
    scores.sort(key=lambda x: -x[1])
    idxs = [i for i,_ in scores[:k]]
    return Vproj[idxs]

# --- Feasibility check and nearest feasible vertex -------------------------
def is_feasible(candidate, V_all):
    return any(np.allclose(candidate, v) for v in V_all)

def nearest_feasible_vertex(candidate, V_all):
    dists = np.linalg.norm(V_all - candidate, axis=1)
    return V_all[np.argmin(dists)]

# --- Simple empirical Fisher proxy ----------------------------------------
# For this toy model we build a synthetic Fisher block matrix whose off-diagonal
# scale is controlled by a parameter f_scale. This simulates cross-information.
def synthetic_fisher(f_scale):
    # diagonal blocks
    F_A = np.eye(2) * 1.0
    F_B = np.eye(2) * 1.0
    # off-diagonal
    F_AB = np.ones((2,2)) * f_scale
    F = np.block([[F_A, F_AB],[F_AB.T, F_B]])
    return F

def compute_epsilon(F):
    F_diag = np.block([[F[:2,:2], np.zeros((2,2))],[np.zeros((2,2)), F[2:,2:]]])
    num = np.linalg.norm(F[:2,2:], ord='fro')
    den = np.linalg.norm(F_diag, ord='fro')
    return num/den if den>0 else np.inf

# --- Experiment loop -------------------------------------------------------
def run_experiment(strength_values, f_scales, topk=4):
    results = []
    for strength in strength_values:
        # global best over vertices
        vals = [objective(v, strength) for v in V]
