### Notebook skeleton (Python + NumPy) — Experiment 1

Below is a runnable skeleton you can paste into a Jupyter notebook. It implements the toy model with two scalar blocks and the `face_bowl` coupling. Replace placeholder functions with your concrete implementations as needed.

```python
# Notebook skeleton: extremal_probe_demo.py
import numpy as np
import itertools
import matplotlib.pyplot as plt

# --- Problem setup ---------------------------------------------------------
# Box H = [0,1]^4 with theta = (lambda, sigma, k, B)
bounds = np.array([[0.0,1.0]]*4)

def face_bowl(theta, strength):
    # theta: array-like [lambda, sigma, k, B]
    lam, sig = theta[0], theta[1]
    return -strength * (1 - (lam - 0.5)**2) * (1 - (sig - 0.5)**2)

def g_block(thetaA, alpha=(1.0,2.0)):
    # thetaA = (lambda, k)
    lam, k = thetaA
    return alpha[0]*lam + alpha[1]*k

def h_block(thetaB, beta=(3.0,4.0)):
    # thetaB = (B, sigma)
    B, sig = thetaB
    return beta[0]*B + beta[1]*sig

def objective(theta, strength):
    # theta: length-4 array
    thetaA = theta[[0,2]]
    thetaB = theta[[3,1]]
    return g_block(thetaA) + h_block(thetaB) + face_bowl(theta, strength)

# --- Vertex enumeration for H ----------------------------------------------
def vertices_of_box(bounds):
    # bounds: (n,2) array
    n = bounds.shape[0]
    verts = []
    for bits in itertools.product([0,1], repeat=n):
        v = np.array([bounds[i,bits[i]] for i in range(n)])
        verts.append(v)
    return np.array(verts)

V = vertices_of_box(bounds)

# --- Marginal projections and top-k selection -------------------------------
def project_vertices(V, indices):
    # return unique projected vertices
    proj = np.unique(V[:, indices], axis=0)
    return proj

# Indices: A = [0,2], B = [3,1]
idxA = [0,2]
idxB = [3,1]
V_A = project_vertices(V, idxA)
V_B = project_vertices(V, idxB)

def score_marginal_A(vA):
    return g_block(vA)

def score_marginal_B(vB):
    return h_block(vB)

# --- Top-k selection -------------------------------------------------------
def top_k_candidates(Vproj, score_fn, k=4):
    scores = [(i, score_fn(Vproj[i])) for i in range(len(Vproj))]
    scores.sort(key=lambda x: -x[1])
    idxs = [i for i,_ in scores[:k]]
    return Vproj[idxs]

# --- Feasibility check and nearest feasible vertex -------------------------
def is_feasible(candidate, V_all):
    # candidate is full-length theta; check membership in vertex set
    return any(np.allclose(candidate, v) for v in V_all)

def nearest_feasible_vertex(candidate, V_all):
    # simple nearest by Euclidean distance
    dists = np.linalg.norm(V_all - candidate, axis=1)
    return V_all[np.argmin(dists)]

# --- Experiment loop -------------------------------------------------------
def run_experiment(strength_values, fisher_eps_values, topk=4):
    results = []
    for strength in strength_values:
        # compute global grid optimum (brute force over vertices for demo)
        vals = [objective(v, strength) for v in V]
        global_best_idx = int(np.argmax(vals))
        global_best = V[global_best_idx]
        global_val = vals[global_best_idx]

        # separable probe via top-k
        TA = top_k_candidates(V_A, score_marginal_A, k=topk)
        TB = top_k_candidates(V_B, score_marginal_B, k=topk)

        best_val = -np.inf
        best_theta = None
        for a in TA:
            for b in TB:
                # assemble candidate in order [lambda, sigma, k, B]
                cand = np.array([a[0], b[1], a[1], b[0]])
                if is_feasible(cand, V):
                    val = objective(cand, strength)
                else:
                    vprime = nearest_feasible_vertex(cand, V)
                    val = objective(vprime, strength)
                if val > best_val:
                    best_val = val
                    best_theta = cand

        results.append({
            'strength': strength,
            'global_val': global_val,
            'probe_val': best_val,
            'global_theta': global_best,
            'probe_theta': best_theta,
            'gap': global_val - best_val
        })
    return results

# --- Run and plot ----------------------------------------------------------
strengths = [0.5, 1.0, 2.0, 4.0]
res = run_experiment(strengths, fisher_eps_values=None, topk=4)

for r in res:
    print(r)

# Plot gap vs strength
plt.plot([r['strength'] for r in res], [r['gap'] for r in res], marker='o')
plt.xlabel('face_bowl strength')
plt.ylabel('global - probe gap')
plt.title('Probe gap vs coupling strength')
plt.grid(True)
plt.show()
```

**Notes for implementation.**  
- Replace the `nearest_feasible_vertex` correction with a Fisher‑aware correction when you have an empirical \(F\).  
- Compute empirical \(\varepsilon\) from your data and evaluate \(\Phi(\varepsilon)\) to produce certificates alongside numeric gaps.  
- Extend the grid search to continuous optimization if you want nonvertex global optima for nonbox \(H\).

