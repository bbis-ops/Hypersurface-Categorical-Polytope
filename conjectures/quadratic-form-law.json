{
  "schema": "gitcalculator.conjecture.v1",
  "name": "quadratic-form-law",
  "title": "Positivity on the orthant decides the quadratic form",
  "statement": "On the square with $F = -(x_0^4 + x_1^4)$ and $G = t x_0^2 + u x_0 x_1 - x_1^2$, the response is $\\Theta(s^2)$ exactly when the form $t c_0^2 + u c_0 c_1 - c_1^2$ is positive somewhere on the open orthant, that is when $t \\gt 0$, or $u \\gt 0$ and $u^2 \\gt -4t$. Otherwise the response is zero. The certificate's sufficient tests decide only part of this window; certified bounds test the rest.",
  "rule": "if(t > 0 or (u > 0 and u*u > -4*t), 2, none)",
  "corpus": {
    "kind": "family",
    "system": "([[-1,0],[0,-1],[1,0],[0,1]], [0,0,1,1])",
    "base": "-(x0**4+x1**4)",
    "perturbation": "t*x0**2 + u*x0*x1 - x1**2",
    "t": [
      "-1",
      "1"
    ],
    "u": [
      "-1",
      "1"
    ],
    "points": 6
  },
